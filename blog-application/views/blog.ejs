<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
        <title>Blog</title>
</head>

<body>
    <%- include('./partials/nav.ejs') %>

        <div class="container">
            <h1 class="mt-3">
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImage %>" alt="" width="140vw" height="160vh" class="mt-3">
            <pre class="mt-3"><%= blog.body %></pre>
        </div>
        <div class="container mt-3">
            <img src="<%= blog.createdBy.profileImage %>" width="50px">
            <%= blog.createdBy.fullName %>
        </div>
        <div class="container mt-3">
            <h1>Comments</h1>
            <% if (locals.user) { %>
                <form action="/blogs/comments/<%= blog._id %>" method="post" >
                    <input
                     type="text" name="content"
                     class="form-control"
                     placeholder="enter your comments here"
                    >
                    <button
                     class="btn btn-sm btn-primary"
                     type="sumbit">Add</button>
                </form>
            <% } %>
        </div>
        <div class="mt-3 container">
            <% comments.forEach(comment => { %>
                <span>
                    <img src="<%= comment.createdBy.profileImage %>" width="50px">
                    <%= comment.createdBy.fullName %> : <pre><%= comment.content %></pre>
                </span>    
            <% }) %>
        </div>

        <%- include('./partials/script.ejs') %>
</body>

</html>