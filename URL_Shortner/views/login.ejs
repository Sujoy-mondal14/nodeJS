<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login</title>
</head>
<body>
    <h1>login</h1>
    <form action="/users/login" method="POST">

        <label for="">Enter Your Email</label>
        <input type="text"
            required
            name="email"
        >
        <label for="">Enter Your Password</label>
        <input type="text"
            required
            name="password"
        >
        <button type="submit">login</button>
    </form>
</body>
</html>